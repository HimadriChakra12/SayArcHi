#!/bin/bash

# wiki - Advanced Wikipedia search with history and quick access
# Usage: wiki <search term>
#        wiki -h (show history)
#        wiki -c (clear cache)

CACHE_DIR="$HOME/.cache/wiki-tui"
HISTORY_FILE="$CACHE_DIR/history.txt"
CACHE_EXPIRY=604800  # 7 days
MAX_RESULTS=20

mkdir -p "$CACHE_DIR"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

show_help() {
    cat << EOF
${CYAN}wiki - Wikipedia Terminal Reader${NC}

${GREEN}Usage:${NC}
  wiki <search term>     Search and read Wikipedia articles
  wiki -h, --history     Show search history
  wiki -c, --clear       Clear cache and history
  wiki --help            Show this help

${GREEN}Examples:${NC}
  wiki Cell Membrane
  wiki "Albert Einstein"
  wiki Neural Networks

${GREEN}Features:${NC}
  • Multi-word search support
  • Article caching for offline reading
  • Search history tracking
  • Fast parallel article fetching
  • Interactive article preview
  • Vim-based reading mode

EOF
}

clear_cache() {
    echo -e "${YELLOW}Clearing cache...${NC}"
    rm -rf "$CACHE_DIR"/*.txt "$CACHE_DIR"/*.meta
    echo -e "${GREEN}Cache cleared!${NC}"
}

show_history() {
    if [[ ! -f "$HISTORY_FILE" ]]; then
        echo -e "${YELLOW}No search history yet${NC}"
        exit 0
    fi
    
    echo -e "${CYAN}Recent Wikipedia Searches:${NC}"
    selected=$(tac "$HISTORY_FILE" | awk '!seen[$0]++' | head -20 | \
        fzf --height=40% \
            --border=rounded \
            --prompt="📜 History > " \
            --header="Enter to search again | Esc to cancel")
    
    if [[ -n "$selected" ]]; then
        exec "$0" "$selected"
    fi
    exit 0
}

# Parse arguments
case "$1" in
    -h|--history)
        show_history
        ;;
    -c|--clear)
        clear_cache
        exit 0
        ;;
    --help)
        show_help
        exit 0
        ;;
    "")
        echo -e "${RED}Error: No search term provided${NC}"
        echo "Try: wiki --help"
        exit 1
        ;;
esac

# Get search term
search_term="$*"

# Save to history
echo "$search_term" >> "$HISTORY_FILE"

echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}📚 Searching Wikipedia: ${YELLOW}$search_term${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# URL encode properly using jq
url_encoded=$(printf '%s' "$search_term" | jq -sRr @uri)

# Fetch with timeout and error handling
search_json=$(curl -s --max-time 10 \
    "https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=$url_encoded&srlimit=$MAX_RESULTS&format=json")

if [[ $? -ne 0 ]]; then
    echo -e "${RED}Error: Network error or timeout${NC}"
    exit 1
fi

# Parse results
titles=$(echo "$search_json" | jq -r '.query.search[]? | .title' 2>/dev/null)

if [[ -z "$titles" ]]; then
    echo -e "${RED}No results found for: $search_term${NC}"
    
    # Suggest similar searches
    echo -e "\n${YELLOW}Try:${NC}"
    echo "  • Check spelling"
    echo "  • Use different keywords"
    echo "  • Try broader terms"
    exit 1
fi

result_count=$(echo "$titles" | wc -l)
echo -e "${GREEN}✓ Found $result_count articles${NC}\n"

# Fetch function with better error handling
fetch_cache() {
    local title="$1"
    local safe_title=$(echo "$title" | sed 's/[^a-zA-Z0-9]/_/g')
    local cache_file="$CACHE_DIR/${safe_title}.txt"
    local meta_file="$CACHE_DIR/${safe_title}.meta"
    
    # Check cache freshness
    if [[ -f "$cache_file" && -f "$meta_file" ]]; then
        local cache_time=$(cat "$meta_file")
        local current_time=$(date +%s)
        if [[ $((current_time - cache_time)) -lt $CACHE_EXPIRY ]]; then
            return 0
        fi
    fi
    
    # Fetch new content
    local url_title=$(printf '%s' "$title" | jq -sRr @uri)
    local page_json=$(curl -s --max-time 15 \
        "https://en.wikipedia.org/w/api.php?action=query&prop=extracts&explaintext&titles=$url_title&format=json" \
        2>/dev/null)
    
    if [[ $? -eq 0 && -n "$page_json" ]]; then
        local page_content=$(echo "$page_json" | jq -r '.query.pages | to_entries[0].value.extract // empty')
        if [[ -n "$page_content" ]]; then
            echo "$page_content" > "$cache_file"
            date +%s > "$meta_file"
        fi
    fi
}

export -f fetch_cache
export CACHE_DIR CACHE_EXPIRY

# Parallel caching with spinner
echo -e "${YELLOW}⟳ Caching articles...${NC}"
echo "$titles" | xargs -P 10 -I {} bash -c 'fetch_cache "$@"' _ {} &
wait

# Interactive selection with rich preview
selected=$(echo "$titles" | fzf \
    --height=85% \
    --border=rounded \
    --border-label=" 📚 Wikipedia Search Results " \
    --prompt="❯ " \
    --pointer="▶" \
    --marker="✓" \
    --header="↑↓ Navigate | Enter: Read | Tab: Preview | Esc: Cancel" \
    --preview-window=right:65%:wrap:border-left \
    --color="border:#00ff87,label:#87afff,header:#ffaf00" \
    --preview 'safe_title=$(echo {} | sed "s/[^a-zA-Z0-9]/_/g");
               cache_file="'"$CACHE_DIR"'/${safe_title}.txt";
               if [[ -f "$cache_file" ]]; then
                   echo -e "\033[1;96m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m";
                   echo -e "\033[1;36m{}\033[0m";
                   echo -e "\033[1;96m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n";
                   head -n 100 "$cache_file" | fold -s -w 75;
                   echo -e "\n\033[2m... Press Enter to read full article ...\033[0m";
               else
                   echo -e "\033[1;33m⟳ Loading preview...\033[0m";
               fi')

if [[ -n "$selected" ]]; then
    safe_title=$(echo "$selected" | sed 's/[^a-zA-Z0-9]/_/g')
    cache_file="$CACHE_DIR/${safe_title}.txt"
    
    if [[ ! -f "$cache_file" ]]; then
        echo -e "${RED}Error: Article not cached${NC}"
        exit 1
    fi
    
    # Create formatted temporary file
    tmpfile=$(mktemp /tmp/wiki_article.XXXXXX.txt)
    
    cat > "$tmpfile" << EOF
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

                                $selected

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

EOF
    
    cat "$cache_file" >> "$tmpfile"
    
    # Open with best available reader
    if command -v nvim &> /dev/null; then
        nvim "$tmpfile" -c "set wrap linebreak" -c "ReaderMode" 2>/dev/null || \
        nvim "$tmpfile" -c "set wrap linebreak nolist" -c "nnoremap q :q<CR>"
    elif command -v vim &> /dev/null; then
        vim "$tmpfile" -c "set wrap linebreak nolist" -c "nnoremap q :q<CR>"
    else
        less -R "$tmpfile"
    fi
    
    rm "$tmpfile"
    echo -e "${GREEN}✓ Article read${NC}"
else
    echo -e "${YELLOW}No selection made${NC}"
fi
